<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mvsciencefair.sponsorbot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>$HOME/mv-sponsor-bot/run_daily.sh</string>
  </array>

  <!-- 19:00 Pacific, set 2026-09-13 at Eeshan's direction for the three day
       sprint. An evening send lands at the top of the next business morning's
       inbox instead of competing with it, and it let the first of the three
       batches go out the same evening the sprint was ordered. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <!-- If the mini was asleep or off at 09:10, run once on the next wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/eeshan/mv-sponsor-bot/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/eeshan/mv-sponsor-bot/logs/launchd.err.log</string>

  <key>WorkingDirectory</key>
  <string>/Users/eeshan/mv-sponsor-bot</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>SPONSOR_CAP</key><string>300</string>
    <key>SPONSOR_GAP</key><string>22</string>
    <!-- Minutes the send may wait for the rolling 24h window to clear last
         night's batch before giving up and sending whatever is allowed. -->
    <key>SPONSOR_WAIT</key><string>240</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>

  <!-- One run at a time. A long research stage must never overlap the next day's. -->
  <key>AbandonProcessGroup</key>
  <false/>
</dict>
</plist>
